{
  "manifest_version": 3,
  "name": "Copiloto CRM | Casa Bonita",
  "version": "0.3.5",
  "minimum_chrome_version": "116",
  "description": "Painel lateral do CRM para consulta e sugestões durante o atendimento.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://mjtphztvjnfjlhtxtwjz.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Copiloto Casa Bonita"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "active-chat.js"
      ]
    }
  ]
}
